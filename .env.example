# =============================================================================
# XEN — environment template. Copy to `.env` (never commit `.env`).
# Web app (Vercel): set these in Project Settings → Environment Variables.
# Worker (Cloudflare): `wrangler secret put NAME` for secrets; non-secrets in wrangler.toml [vars].
# =============================================================================

# ---- REQUIRED ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=                # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # public anon key (RLS enforced)
SUPABASE_SERVICE_ROLE_KEY=               # SERVER ONLY. Never expose to the browser.
GEMINI_API_KEY=                          # https://aistudio.google.com/apikey (free tier)
CRON_SECRET=                             # random ≥32 chars: `openssl rand -hex 32`

# ---- REQUIRED FOR THE DISCOVERY → TELEGRAM MILESTONE ------------------------
TAVILY_API_KEY=                          # https://app.tavily.com (free: 1,000 credits/month)
TELEGRAM_BOT_TOKEN=                      # from @BotFather
TELEGRAM_WEBHOOK_SECRET=                 # random 32+ chars, [A-Za-z0-9_-] only
TELEGRAM_CHAT_ID=                        # your private chat id with the bot (owner alerts)

# ---- DEFAULTS (override if needed) ------------------------------------------
GEMINI_MODEL=gemini-3.5-flash-lite       # stable, free-tier; gemini-2.5-flash routes elsewhere from 2026-12-01
DEFAULT_TIMEZONE=Africa/Lagos

# ---- OPTIONAL INTEGRATIONS (app works without them) -------------------------
FIRECRAWL_API_KEY=
GITHUB_TOKEN=                            # fine-grained, public-repo read only; raises limit 60 → 5,000/h
DISCORD_BOT_TOKEN=                       # only for servers that invited the bot
X_BEARER_TOKEN=                          # X search requires a paid tier

# ---- FEATURE FLAGS ----------------------------------------------------------
FEATURE_GEMINI_GROUNDING=false           # Google Search grounding is not on the free tier for Gemini 3.x
FEATURE_FIRECRAWL=false
FEATURE_X=false
FEATURE_DISCORD=false
FEATURE_REDDIT=true

# ---- BUDGETS (per UTC day) --------------------------------------------------
BUDGET_TAVILY_DAILY=30                   # ≈ 900/month, under the 1,000 free credits
BUDGET_GEMINI_DAILY=200
BUDGET_FIRECRAWL_DAILY=10
BUDGET_GEMINI_MAX_INPUT_CHARS=24000
SEARCH_CACHE_HOURS=24
PIPELINE_MAX_ITEMS_PER_RUN=4

# ---- WORKER ONLY ------------------------------------------------------------
# PIPELINE_RUNNER_URL=https://<your-app>.vercel.app/api/pipeline/tick
